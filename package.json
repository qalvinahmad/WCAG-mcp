{
  "name": "wcag-accessibility-toolkit",
  "version": "0.1.0",
  "description": "WCAG 2.2 accessibility audit toolkit and agent guidance for automated and manual reviews.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "wcag-accessibility-toolkit": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/cli.js"
  },
  "keywords": [
    "wcag",
    "accessibility",
    "a11y",
    "mcp",
    "tools"
  ],
  "license": "MIT",
  "files": [
